# PULSE test range — single-VM (Option A) deployment on eng-hmi (10.26.30.10)
# All services collapsed onto localhost. Pass to attack/detection scripts with:
#   python attacks/scada_breaker_attack.py --all --env-file deployment/dev-range.env
#   python detection/scada_breaker_detect.py --env-file deployment/dev-range.env

# PLCs (plc_simulator.py runs all four locally on different ports)
MG1_PLC_HOST=127.0.0.1
MG1_PLC_MODBUS_PORT=502
MG2_PLC_HOST=127.0.0.1
MG2_PLC_MODBUS_PORT=503
MG3_PLC_HOST=127.0.0.1
MG3_PLC_MODBUS_PORT=504
MG4_PLC_HOST=127.0.0.1
MG4_PLC_MODBUS_PORT=505

# SCADA Gateway (gateway_simulator.py)
SCADA_GATEWAY_HOST=127.0.0.1
SCADA_GATEWAY_PORT=5020

# ScadaLTS (docker-compose scadalts container, port published on host)
SCADALTS_HOST=127.0.0.1
SCADALTS_PORT=8080

# MySQL (docker-compose database container)
# Note: historian attack uses docker exec scada_database mysql by default —
# that works as long as the container is named scada_database (it is).
# Pass --tcp to use TCP instead (e.g. from a remote host).
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
